{
  "name": "Forgotten chrome extension",
  "manifest_version": 3,
  "version": "1.2",
  "permissions": ["userScripts", "declarativeNetRequest"],
  "background": {
      "service_worker": "background.js"
  },
  "content_scripts": [{
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames":true
  }],
  "host_permissions": [
      "<all_urls>"
  ]
}
