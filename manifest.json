{
  "name": "Forgotten chrome extension",
  "description": "Безопасное расширение Forgotten для работы с чат-рулетками.",
  "manifest_version": 3,
  "version": "1.4.0",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Forgotten",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "permissions": ["userScripts", "declarativeNetRequest", "cookies"],
  "background": {
      "service_worker": "background.js"
  },
  "content_scripts": [{
      "matches": [
        "https://forgotten-society.com/*",
        "https://www.forgotten-society.com/*",
        "http://localhost/*",
        "https://localhost/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "all_frames":true
  }],
  "host_permissions": [
      "https://forgotten-society.com/*",
      "https://www.forgotten-society.com/*",
      "http://localhost/*",
      "https://localhost/*",
      "https://nekto.me/*",
      "https://*.nekto.me/*",
      "https://chatfish.ru/*",
      "https://*.chatfish.ru/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  }
}
