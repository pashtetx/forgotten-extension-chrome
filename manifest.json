{
    "name": "Forgotten chrome extension",
    "manifest_version": 3,
    "minimum_chrome_version": "120",
    "version": "1.0",
    "permissions": [
        "userScripts"
    ],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content-script.js"],
            "run_at": "document_start",
            "world": "MAIN",
            "all_frames":true
        }
    ]
}